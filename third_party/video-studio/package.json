{
  "name": "bestsnap-video-studio",
  "version": "1.0.0",
  "description": "BestSnap video editor: a modified Video Studio (AGPL-3.0) multi-track editor. Timeline editing, text, effects, transitions, filters, keyframes, captions and export, stored on this device.",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node tools/check-host-sdk.mjs",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "build:wasm": "node tools/build-wasm.mjs",
    "check:licenses": "node tools/check-licenses.mjs",
    "check:host": "node tools/check-host-sdk.mjs",
    "prebuild": "npm run check:licenses && npm run check:host"
  },
  "dependencies": {
    "@fontsource/anton": "5.3.0",
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/dancing-script": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/lobster": "5.3.0",
    "@fontsource/merriweather": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/oswald": "5.3.0",
    "@fontsource/pacifico": "5.3.0",
    "@fontsource/permanent-marker": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@fontsource/roboto-mono": "5.3.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "lucide": "1.54.0",
    "mediabunny": "1.61.3"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "jsdom": "30.1.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
