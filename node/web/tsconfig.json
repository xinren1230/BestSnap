{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@core/*": ["../src/core/*"]
    }
  },
  "include": ["src/**/*.ts", "e2e/**/*.ts", "../src/core/**/*.ts"]
}
